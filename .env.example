# LLM provider: openrouter or gemini
LLM_PROVIDER=openrouter

# OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# auto = LLM agent if the selected provider has a key, otherwise the rule-based agent.
# Can also be llm or rules.
AGENT_MODE=auto
AGENT_MAX_TURNS=30
# Output tokens per model reply. Tool calls are short; keep this low on small credit balances.
AGENT_MAX_TOKENS=4000

# Mock data is generated relative to this date
SIMULATION_DATE=2026-10-22

# Purchasing policy
AUTO_APPROVE_LIMIT=3000
MAX_PRICE_PREMIUM=0.10
MAX_COVER_DAYS=30

# Optional overrides
# DATABASE_PATH=backend/data/purchasing.db
# CORS_ORIGINS=http://localhost:5173
